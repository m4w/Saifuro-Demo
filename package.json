    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
